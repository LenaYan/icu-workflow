#!/usr/bin/env bash
# ICU workflow pre-commit：PHI 扫描 + 病例 lint + 双栈同步 + 计算器单测
# 启用：git config core.hooksPath scripts/hooks
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0

echo "▶ PHI 扫描（暂存区）"
python3 scripts/phi_scan.py --staged || fail=1

case_docs=()
while IFS= read -r -d '' f; do
  case "$f" in
    cases/_*|cases/*/_*|*/README.md) ;;
    cases/*.md) case_docs+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ ${#case_docs[@]} -gt 0 ]; then
  echo "▶ 病例分析 lint（暂存病例 ${#case_docs[@]} 个，仅检查深度分析文档）"
  python3 scripts/check_case_doc.py --auto "${case_docs[@]}" | grep -E 'ERROR|^==|个文件' || true
  python3 scripts/check_case_doc.py --auto "${case_docs[@]}" >/dev/null || fail=1
fi

echo "▶ 双栈指令同步校验"
python3 scripts/sync_instructions.py --check || fail=1

if git diff --cached --name-only | grep -qE '^(scripts/clinical_calc\.py|tests/)'; then
  echo "▶ clinical_calc 单测"
  python3 -m unittest discover -s tests -q 2>&1 | tail -3
  python3 -m unittest discover -s tests -q >/dev/null 2>&1 || fail=1
fi

if [ $fail -ne 0 ]; then
  echo "✖ pre-commit 未通过：请按上方提示修正（PHI 误报可在该行加 phi-ok 并人工确认）"
  exit 1
fi
echo "✔ pre-commit 通过"
